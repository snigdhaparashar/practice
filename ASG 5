#include<stdio.h>
#include<string.h>
int main()
{
    char s1[100], s2[100];
    int choice;
    
    
        printf("\n1. Length 2.Copy 3.Concat 4.Compare 5.Exit\nEnter choice");
        scanf("%d", &choice);
        
        
        switch (choice)   {
              case 1:
                printf("Enter string: ");
                scanf("%s" , s1);
                printf("Length: %lu\n" , strlen(s1));
                printf("Enter string: ");
                scanf("%s" , s2);
                printf("Length: %lu\n" , strlen(s2));
                break;
              case 2:
                printf("Enter string: ");
                scanf("%s" , s1);
                printf("Enter string: ");
                scanf("%s" , s2);
                strcpy(s2, s1);
                printf("Copied: %s\n" , s2);
                break;
              case 3:
                printf("Enter string: ");
                scanf("%s" , s1);
                printf("Enter string: ");
                scanf("%s" , s2);
                strcat(s1 , s2);
                printf("Concatenate: %s\n" , s1);
                break;
              case 4:
                printf("Enter string: ");
                scanf("%s" , s1);
                printf("Enter string: ");
                scanf("%s" , s2);
                strcmp(s1 , s2);
                printf("Comparision: %d\n");
                break;
                
                default:
                  printf("Invalid choice");
                  break;
                  
                
      }
    
return 0;
}
